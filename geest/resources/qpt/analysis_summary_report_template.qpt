 <LayoutMultiFrame templateUuid="{618c7ce0-106f-4905-96b2-6a9a492b3784}" evaluateExpressions="true" url="" resizeMode="0" stylesheet="body { margin: 33.3333 33.3333;line-height: 122%;color: rgba(0,0,0,1.0000);font-family: Noto Sans, ;font-style: normal;font-weight: 400;font-size: 26.4583px;text-align: center; }" type="65648" contentMode="1" html="&lt;h2>Analysis Summary&lt;/h2>&#xa;&#xa;" uuid="{618c7ce0-106f-4905-96b2-6a9a492b3784}" maxBreakDistance="10" useSmartBreaks="true" stylesheetEnabled="true">
  <childFrame templateUuid="{2d7ec56b-6749-4ca4-bc30-a4336799b16a}" uuid="{2d7ec56b-6749-4ca4-bc30-a4336799b16a}"/>
  <LayoutObject>
